{
  "manifest_version": 3,
  "name": "JoqniX Cookie Sync",
  "version": "0.5.0",
  "description": "Sync complete browser cookie jars for JoqniX services.",
  "permissions": [
    "cookies",
    "storage",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtube.com/*",

    "https://*.google.com/*",
    "https://google.com/*",

    "https://*.twitch.tv/*",
    "https://twitch.tv/*",

    "https://*.kick.com/*",
    "https://kick.com/*",

    "https://*.meldstudio.co/*",
    "https://meldstudio.co/*",

    "https://*.casterlabs.co/*",
    "https://casterlabs.co/*",

    "https://api.joqnix.space/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JoqniX Cookie Sync",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
